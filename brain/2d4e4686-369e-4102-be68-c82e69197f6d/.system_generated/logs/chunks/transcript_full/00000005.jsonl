{"step_index":339,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-24T09:41:10Z","content":"Created At: 2026-11-24T14:41:10+05:00\nCompleted At: 2026-11-24T14:41:11+05:00\nCreated At: 2026-11-24T14:41:10+05:00\nCompleted At: 2026-11-24T14:41:11+05:00\nShowing lines 1-100 of 123\n1: import { EngineEvaluation } from '../types/chess';\n2: \n3: export interface ParsedUciLine {\n4:   type: 'uciok' | 'readyok' | 'bestmove' | 'info' | 'other';\n5:   raw: string;\n6:   bestMove?: string;\n7:   ponder?: string;\n8:   evalInfo?: EngineEvaluation;\n9: }\n10: \n11: export class UciAdapter {\n12:   /**\n13:    * Parse a raw line emitted by Stockfish engine\n14:    */\n15:   public static parse(line: string): ParsedUciLine {\n16:     const trimmed = line.trim();\n17: \n18:     if (trimmed === 'uciok') {\n19:       return { type: 'uciok', raw: trimmed };\n20:     }\n21: \n22:     if (trimmed === 'readyok') {\n23:       return { type: 'readyok', raw: trimmed };\n24:     }\n25: \n26:     if (trimmed.startsWith('bestmove')) {\n27:       // Format: bestmove e7e5 [ponder g1f3] or bestmove (none)\n28:       const parts = trimmed.split(' ');\n29:       const bestMove = parts[1] !== '(none)' ? parts[1] : undefined;\n30:       const ponderIndex = parts.indexOf('ponder');\n31:       const ponder = ponderIndex !== -1 ? parts[ponderIndex + 1] : undefined;\n32: \n33:       return {\n34:         type: 'bestmove',\n35:         raw: trimmed,\n36:         bestMove,\n37:         ponder,\n38:       };\n39:     }\n40: \n41:     if (trimmed.startsWith('info') && (trimmed.includes('score') || trimmed.includes('depth'))) {\n42:       const evalInfo = this.parseInfoLine(trimmed);\n43:       return {\n44:         type: 'info',\n45:         raw: trimmed,\n46:         evalInfo,\n47:       };\n48:     }\n49: \n50:     return { type: 'other', raw: trimmed };\n51:   }\n52: \n53:   private static parseInfoLine(line: string): EngineEvaluation {\n54:     const tokens = line.split(' ');\n55:     const result: EngineEvaluation = {\n56:       depth: 0,\n57:     };\n58: \n59:     for (let i = 0; i < tokens.length; i++) {\n60:       const token = tokens[i];\n61:       if (token === 'depth' && tokens[i + 1]) {\n62:         result.depth = parseInt(tokens[i + 1], 10);\n63:       } else if (token === 'seldepth' && tokens[i + 1]) {\n64:         result.seldepth = parseInt(tokens[i + 1], 10);\n65:       } else if (token === 'score') {\n66:         const type = tokens[i + 1];\n67:         const val = parseInt(tokens[i + 2], 10);\n68:         if (type === 'cp') {\n69:           result.scoreCp = val;\n70:         } else if (type === 'mate') {\n71:           result.scoreMate = val;\n72:         }\n73:       } else if (token === 'nodes' && tokens[i + 1]) {\n74:         result.nodes = parseInt(tokens[i + 1], 10);\n75:       } else if (token === 'nps' && tokens[i + 1]) {\n76:         result.nps = parseInt(tokens[i + 1], 10);\n77:       } else if (token === 'time' && tokens[i + 1]) {\n78:         result.timeMs = parseInt(tokens[i + 1], 10);\n79:       } else if (token === 'pv') {\n80:         result.pv = tokens.slice(i + 1, i + 6).join(' ');\n81:       }\n82:     }\n83: \n84:     return result;\n85:   }\n86: \n87:   /**\n88:    * Convert a UCI move string (e.g. 'e2e4' or 'e7e8q') into chess.js move params\n89:    */\n90:   public static uciToChessMove(uciMove: string): {\n91:     from: string;\n92:     to: string;\n93:     promotion?: 'q' | 'r' | 'b' | 'n';\n94:   } {\n95:     const from = uciMove.slice(0, 2);\n96:     const to = uciMove.slice(2, 4);\n97:     const promoChar = uciMove.length > 4 ? uciMove[4].toLowerCase() : undefined;\n98:     const promotion = promoChar && ['q', 'r', 'b', 'n'].includes(promoChar)\n99:       ? (promoChar as 'q' | 'r' | 'b' | 'n')\n100:       : undefined;"}
