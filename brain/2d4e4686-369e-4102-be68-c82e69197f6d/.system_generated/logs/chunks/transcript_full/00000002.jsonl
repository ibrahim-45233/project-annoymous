{"step_index":153,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-23T16:26:07Z","model":"gemini-3.8-flash-high","input_tokens":4117,"cache_read_tokens":77298,"output_tokens":1538,"thinking":"Initial hypothesis: a dedicated hook, `useStockfish.ts`, will manage Stockfish AI integration with the chess game. This hook will handle difficulty settings (beginner to expert), search depth, and time limits, reacting to the AI's turn based on game state (e.g., black's turn, game not over). It should calculate the best move given the current FEN and send it to the AI engine.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import { useState, useEffect, useCallback, useRef } from 'react';\nimport { Color, Square, PieceSymbol } from 'chess.js';\nimport { DifficultyConfig, DIFFICULTY_PRESETS, EngineEvaluation, EngineStatus, GameDifficulty } from '../types/chess';\nimport { stockfishEngine } from '../engine/stockfishService';\nimport { UciAdapter } from '../engine/uciAdapter';\n\ninterface UseStockfishProps {\n  fen: string;\n  turn: Color;\n  isGameOver: boolean;\n  aiColor: Color;\n  executeMove: (from: Square, to: Square, promotion?: PieceSymbol) => void;\n}\n\nexport function useStockfish({\n  fen,\n  turn,\n  isGameOver,\n  aiColor,\n  executeMove,\n}: UseStockfishProps) {\n  const [difficulty, setDifficulty] = useState<GameDifficulty>('medium');\n  const [customConfig, setCustomConfig] = useState<DifficultyConfig>({\n    name: 'Custom',\n    depth: 10,\n    skillLevel: 12,\n    moveTime: 1500,\n    description: 'Custom user-defined depth and thinking time.',\n  });\n\n  const [engineStatus, setEngineStatus] = useState<EngineStatus>({\n    isReady: false,\n    isThinking: false,\n    isError: false,\n    evalInfo: null,\n  });\n\n  const [hintMove, setHintMove] = useState<{ from: Square; to: Square } | null>(null);\n  const [isCalculatingHint, setIsCalculatingHint] = useState<boolean>(false);\n\n  // Active configuration based on preset or custom\n  const currentConfig: DifficultyConfig = difficulty === 'custom'\n    ? customConfig\n    : DIFFICULTY_PRESETS[difficulty];\n\n  // Subscribe to engine status updates\n  useEffect(() => {\n    const unsubStatus = stockfishEngine.onStatus((status) => {\n      setEngineStatus(status);\n    });\n    return () => unsubStatus();\n  }, []);\n\n  // Update engine difficulty level\n  useEffect(() => {\n    stockfishEngine.setDifficulty(currentConfig);\n  }, [currentConfig]);\n\n  // Keep ref of executeMove to avoid trigger loops\n  const executeMoveRef = useRef(executeMove);\n  executeMoveRef.current = executeMove;\n\n  // Clear hint whenever position changes\n  useEffect(() => {\n    setHintMove(null);\n  }, [fen]);\n\n  // Trigger AI move when it's AI's turn\n  useEffect(() => {\n    if (isGameOver) {\n      stockfishEngine.stop();\n      return;\n    }\n\n    if (turn === aiColor) {\n      let isCancelled = false;\n\n      const triggerAiTurn = async () => {\n        try {\n          const bestMoveUci = await stockfishEngine.calculateBestMove(fen, currentConfig);\n          if (isCancelled || !bestMoveUci || bestMoveUci === '(none)') return;\n\n          const { from, to, promotion } = UciAdapter.uciToChessMove(bestMoveUci);\n          executeMoveRef.current(from as Square, to as Square, promotion);\n        } catch (err) {\n          console.error('Stockfish move calculation failed:', err);\n        }\n      };\n\n      // Slight delay for natural visual pacing\n      const timer = setTimeout(triggerAiTurn, 250);\n      return () => {\n        isCancelled = true;\n        clearTimeout(timer);\n        stockfishEngine.stop();\n      };\n    }\n  }, [fen, turn, aiColor, isGameOver, currentConfig]);\n\n  // Request a hint for human player\n  const requestHint = useCallback(async () => {\n    if (isGameOver || engineStatus.isThinking || isCalculatingHint) return;\n\n    try {\n      setIsCalculatingHint(true);\n      const hintUci = await stockfishEngine.calculateBestMove(fen, {\n        name: 'Hint',\n        depth: Math.max(8, currentConfig.depth),\n        skillLevel: 20, // Grandmaster hint\n        moveTime: 1200,\n        description: 'Engine analysis for hint',\n      });\n\n      if (hintUci && hintUci !== '(none)') {\n        const { from, to } = UciAdapter.uciToChessMove(hintUci);\n        setHintMove({ from: from as Square, to: to as Square });\n      }\n    } catch (err) {\n      console.error('Hint calculation failed:', err);\n    } finally {\n      setIsCalculatingHint(false);\n    }\n  }, [fen, isGameOver, engineStatus.isThinking, isCalculatingHint, currentConfig.depth]);\n\n  const resetEngine = useCallback(() => {\n    stockfishEngine.newGame();\n    setHintMove(null);\n  }, []);\n\n  const restartWorker = useCallback(() => {\n    stockfishEngine.initWorker();\n  }, []);\n\n  return {\n    difficulty,\n    setDifficulty,\n    customConfig,\n    setCustomConfig,\n    currentConfig,\n    engineStatus,\n    isAiThinking: engineStatus.isThinking && turn === aiColor,\n    isCalculatingHint,\n    hintMove,\n    requestHint,\n    resetEngine,\n    restartWorker,\n  };\n}\n","Path":"C:\\Users\\DELL\\.gemini\\antigravity\\scratch\\stockfish-chess-arena\\src\\hooks\\useStockfish.ts"}}]}
