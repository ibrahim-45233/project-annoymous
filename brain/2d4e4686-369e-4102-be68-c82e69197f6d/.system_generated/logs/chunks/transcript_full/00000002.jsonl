{"step_index":151,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-23T16:25:32Z","model":"gemini-3.8-flash-high","input_tokens":2642,"cache_read_tokens":74627,"output_tokens":4070,"thinking":"The chess game management hook requires a `Chess` instance from a chess rules library to handle game logic, including castling, en passant, promotion, checkmate, stalemate, draw conditions, and 3-fold repetition. It will need to maintain the current game state via a FEN string, a move history, and whose turn it is.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import { useState, useCallback, useRef, useEffect } from 'react';\nimport { Chess, Square, PieceSymbol, Color, Move } from 'chess.js';\nimport { GameStatus, MoveRecord } from '../types/chess';\nimport { sounds } from '../audio/soundEffects';\n\nconst PIECE_VALUES: Record<PieceSymbol, number> = {\n  p: 1,\n  n: 3,\n  b: 3,\n  r: 5,\n  q: 9,\n  k: 0,\n};\n\nconst STARTING_PIECES: Record<PieceSymbol, number> = {\n  p: 8,\n  n: 2,\n  b: 2,\n  r: 2,\n  q: 1,\n  k: 1,\n};\n\nexport interface CapturedState {\n  whiteCaptured: PieceSymbol[]; // Pieces captured BY white (black pieces off board)\n  blackCaptured: PieceSymbol[]; // Pieces captured BY black (white pieces off board)\n  materialDifference: number; // Positive = white advantage, Negative = black advantage\n}\n\nexport function useChessGame(initialTimeSeconds: number = 600) {\n  const chessRef = useRef(new Chess());\n  const [fen, setFen] = useState<string>(chessRef.current.fen());\n  const [history, setHistory] = useState<MoveRecord[]>([]);\n  const [turn, setTurn] = useState<Color>('w');\n  const [isGameOver, setIsGameOver] = useState<boolean>(false);\n  const [gameStatus, setGameStatus] = useState<GameStatus>('in_progress');\n  const [selectedSquare, setSelectedSquare] = useState<Square | null>(null);\n  const [legalMoves, setLegalMoves] = useState<Square[]>([]);\n  const [lastMove, setLastMove] = useState<{ from: Square; to: Square } | null>(null);\n  const [boardOrientation, setBoardOrientation] = useState<'white' | 'black'>('white');\n  const [pendingPromotion, setPendingPromotion] = useState<{ from: Square; to: Square } | null>(null);\n\n  // Clocks\n  const [whiteTime, setWhiteTime] = useState<number>(initialTimeSeconds);\n  const [blackTime, setBlackTime] = useState<number>(initialTimeSeconds);\n  const [timerActive, setTimerActive] = useState<boolean>(false);\n\n  // Compute King square if in check\n  const getKingSquare = useCallback((color: Color): Square | null => {\n    const board = chessRef.current.board();\n    for (let r = 0; r < 8; r++) {\n      for (let c = 0; c < 8; c++) {\n        const piece = board[r][c];\n        if (piece && piece.type === 'k' && piece.color === color) {\n          return piece.square;\n        }\n      }\n    }\n    return null;\n  }, []);\n\n  const [checkSquare, setCheckSquare] = useState<Square | null>(null);\n\n  // Calculate captured pieces\n  const getCapturedPieces = useCallback((): CapturedState => {\n    const board = chessRef.current.board();\n    const currentCounts: { w: Record<PieceSymbol, number>; b: Record<PieceSymbol, number> } = {\n      w: { p: 0, n: 0, b: 0, r: 0, q: 0, k: 0 },\n      b: { p: 0, n: 0, b: 0, r: 0, q: 0, k: 0 },\n    };\n\n    for (let r = 0; r < 8; r++) {\n      for (let c = 0; c < 8; c++) {\n        const piece = board[r][c];\n        if (piece) {\n          currentCounts[piece.color][piece.type]++;\n        }\n      }\n    }\n\n    const whiteCaptured: PieceSymbol[] = []; // Black pieces missing\n    const blackCaptured: PieceSymbol[] = []; // White pieces missing\n    let whiteScore = 0;\n    let blackScore = 0;\n\n    (Object.keys(STARTING_PIECES) as PieceSymbol[]).forEach(type => {\n      if (type === 'k') return;\n      const missingBlack = STARTING_PIECES[type] - currentCounts.b[type];\n      for (let i = 0; i < missingBlack; i++) {\n        whiteCaptured.push(type);\n      }\n      const missingWhite = STARTING_PIECES[type] - currentCounts.w[type];\n      for (let i = 0; i < missingWhite; i++) {\n        blackCaptured.push(type);\n      }\n\n      whiteScore += currentCounts.w[type] * PIECE_VALUES[type];\n      blackScore += currentCounts.b[type] * PIECE_VALUES[type];\n    });\n\n    return {\n      whiteCaptured,\n      blackCaptured,\n      materialDifference: whiteScore - blackScore,\n    };\n  }, []);\n\n  // Sync game status\n  const updateStatus = useCallback(() => {\n    const chess = chessRef.current;\n    const currentTurn = chess.turn();\n    setTurn(currentTurn);\n    setFen(chess.fen());\n\n    if (chess.isCheckmate()) {\n      setIsGameOver(true);\n      setGameStatus('checkmate');\n      setCheckSquare(getKingSquare(currentTurn));\n      setTimerActive(false);\n      sounds.playGameOver();\n    } else if (chess.isStalemate()) {\n      setIsGameOver(true);\n      setGameStatus('stalemate');\n      setCheckSquare(null);\n      setTimerActive(false);\n      sounds.playGameOver();\n    } else if (chess.isThreefoldRepetition()) {\n      setIsGameOver(true);\n      setGameStatus('threefold_repetition');\n      setCheckSquare(null);\n      setTimerActive(false);\n      sounds.playGameOver();\n    } else if (chess.isInsufficientMaterial()) {\n      setIsGameOver(true);\n      setGameStatus('insufficient_material');\n      setCheckSquare(null);\n      setTimerActive(false);\n      sounds.playGameOver();\n    } else if (chess.isDraw()) {\n      setIsGameOver(true);\n      setGameStatus('fifty_moves');\n      setCheckSquare(null);\n      setTimerActive(false);\n      sounds.playGameOver();\n    } else if (chess.inCheck()) {\n      setIsGameOver(false);\n      setGameStatus('check');\n      setCheckSquare(getKingSquare(currentTurn));\n      sounds.playCheck();\n    } else {\n      setIsGameOver(false);\n      setGameStatus('in_progress');\n      setCheckSquare(null);\n    }\n  }, [getKingSquare]);\n\n  // Execute a validated move in chess.js\n  const executeMove = useCallback((\n    from: Square,\n    to: Square,\n    promotion?: PieceSymbol\n  ): Move | null => {\n    const chess = chessRef.current;\n\n    try {\n      const isCastle = (chess.get(from)?.type === 'k') && Math.abs(from.charCodeAt(0) - to.charCodeAt(0)) === 2;\n      const targetPiece = chess.get(to);\n      const isCapture = !!targetPiece || (chess.get(from)?.type === 'p' && from[0] !== to[0]);\n\n      const move = chess.move({\n        from,\n        to,\n        promotion: promotion || 'q',\n      });\n\n      if (!move) return null;\n\n      // Audio feedback\n      if (isCastle) {\n        sounds.playCastle();\n      } else if (isCapture) {\n        sounds.playCapture();\n      } else {\n        sounds.playMove();\n      }\n\n      setLastMove({ from, to });\n      setSelectedSquare(null);\n      setLegalMoves([]);\n\n      // Append to history\n      const newRecord: MoveRecord = {\n        san: move.san,\n        from: move.from as Square,\n        to: move.to as Square,\n        piece: move.piece,\n        color: move.color,\n        captured: move.captured,\n        promotion: move.promotion,\n        fenAfter: chess.fen(),\n        moveNumber: Math.floor(chess.history().length / 2) + 1,\n      };\n\n      setHistory(prev => [...prev, newRecord]);\n      setTimerActive(true);\n      updateStatus();\n\n      return move;\n    } catch {\n      return null;\n    }\n  }, [updateStatus]);\n\n  // Check if a move requires promotion\n  const isPromotionMove = useCallback((from: Square, to: Square): boolean => {\n    const chess = chessRef.current;\n    const piece = chess.get(from);\n    if (!piece || piece.type !== 'p') return false;\n\n    // White pawn reaching rank 8 or Black pawn reaching rank 1\n    const targetRank = to[1];\n    if (piece.color === 'w' && targetRank === '8') return true;\n    if (piece.color === 'b' && targetRank === '1') return true;\n\n    // Check if legal\n    const moves = chess.moves({ square: from, verbose: true });\n    return moves.some(m => m.to === to && m.promotion);\n  }, []);\n\n  // Handle piece drop on board\n  const onPieceDrop = useCallback((\n    sourceSquare: Square,\n    targetSquare: Square\n  ): boolean => {\n    if (isGameOver) return false;\n\n    // Check for pawn promotion\n    if (isPromotionMove(sourceSquare, targetSquare)) {\n      setPendingPromotion({ from: sourceSquare, to: targetSquare });\n      return true; // Keep piece in place while modal opens\n    }\n\n    const move = executeMove(sourceSquare, targetSquare);\n    return !!move;\n  }, [isGameOver, isPromotionMove, executeMove]);\n\n  // Select square and compute legal destinations\n  const onSquareClick = useCallback((square: Square) => {\n    if (isGameOver) return;\n\n    const chess = chessRef.current;\n\n    // If clicking a square that is already a legal move from previously selected square\n    if (selectedSquare && legalMoves.includes(square)) {\n      if (isPromotionMove(selectedSquare, square)) {\n        setPendingPromotion({ from: selectedSquare, to: square });\n        return;\n      }\n      executeMove(selectedSquare, square);\n      return;\n    }\n\n    // Otherwise select piece on square if it matches current turn\n    const piece = chess.get(square);\n    if (piece && piece.color === chess.turn()) {\n      setSelectedSquare(square);\n      const moves = chess.moves({ square, verbose: true }).map(m => m.to as Square);\n      setLegalMoves(moves);\n    } else {\n      setSelectedSquare(null);\n      setLegalMoves([]);\n    }\n  }, [isGameOver, selectedSquare, legalMoves, isPromotionMove, executeMove]);\n\n  // Complete pending promotion\n  const completePromotion = useCallback((piece: PieceSymbol) => {\n    if (!pendingPromotion) return;\n    executeMove(pendingPromotion.from, pendingPromotion.to, piece);\n    setPendingPromotion(null);\n  }, [pendingPromotion, executeMove]);\n\n  const cancelPromotion = useCallback(() => {\n    setPendingPromotion(null);\n    setSelectedSquare(null);\n    setLegalMoves([]);\n  }, []);\n\n  // Undo move (reverts 1 or 2 moves)\n  const undoMove = useCallback((steps: number = 1) => {\n    const chess = chessRef.current;\n    let undoneCount = 0;\n\n    for (let i = 0; i < steps; i++) {\n      const undone = chess.undo();\n      if (undone) undoneCount++;\n    }\n\n    if (undoneCount > 0) {\n      setHistory(prev => prev.slice(0, prev.length - undoneCount));\n      const hist = chess.history({ verbose: true });\n      if (hist.length > 0) {\n        const last = hist[hist.length - 1];\n        setLastMove({ from: last.from as Square, to: last.to as Square });\n      } else {\n        setLastMove(null);\n      }\n      setSelectedSquare(null);\n      setLegalMoves([]);\n      updateStatus();\n    }\n  }, [updateStatus]);\n\n  // Reset entire game\n  const resetGame = useCallback(() => {\n    chessRef.current.reset();\n    setFen(chessRef.current.fen());\n    setHistory([]);\n    setTurn('w');\n    setIsGameOver(false);\n    setGameStatus('in_progress');\n    setSelectedSquare(null);\n    setLegalMoves([]);\n    setLastMove(null);\n    setCheckSquare(null);\n    setPendingPromotion(null);\n    setWhiteTime(initialTimeSeconds);\n    setBlackTime(initialTimeSeconds);\n    setTimerActive(false);\n  }, [initialTimeSeconds]);\n\n  // Flip board perspective\n  const flipBoard = useCallback(() => {\n    setBoardOrientation(prev => (prev === 'white' ? 'black' : 'white'));\n  }, []);\n\n  // Chess clock timer loop\n  useEffect(() => {\n    if (!timerActive || isGameOver) return;\n\n    const interval = setInterval(() => {\n      if (turn === 'w') {\n        setWhiteTime(prev => {\n          if (prev <= 1) {\n            setIsGameOver(true);\n            setGameStatus('timeout');\n            setTimerActive(false);\n            sounds.playGameOver();\n            return 0;\n          }\n          return prev - 1;\n        });\n      } else {\n        setBlackTime(prev => {\n          if (prev <= 1) {\n            setIsGameOver(true);\n            setGameStatus('timeout');\n            setTimerActive(false);\n            sounds.playGameOver();\n            return 0;\n          }\n          return prev - 1;\n        });\n      }\n    }, 1000);\n\n    return () => clearInterval(interval);\n  }, [timerActive, isGameOver, turn]);\n\n  return {\n    chess: chessRef.current,\n    fen,\n    turn,\n    history,\n    isGameOver,\n    gameStatus,\n    selectedSquare,\n    legalMoves,\n    lastMove,\n    checkSquare,\n    boardOrientation,\n    pendingPromotion,\n    whiteTime,\n    blackTime,\n    timerActive,\n    captured: getCapturedPieces(),\n    onPieceDrop,\n    onSquareClick,\n    executeMove,\n    completePromotion,\n    cancelPromotion,\n    undoMove,\n    resetGame,\n    flipBoard,\n    setBoardOrientation,\n    setTimerActive,\n  };\n}\n","Path":"C:\\Users\\DELL\\.gemini\\antigravity\\scratch\\stockfish-chess-arena\\src\\hooks\\useChessGame.ts"}}]}
