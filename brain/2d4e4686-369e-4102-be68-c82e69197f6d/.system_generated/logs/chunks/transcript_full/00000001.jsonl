{"step_index":147,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-23T16:24:55Z","model":"gemini-3.8-flash-high","input_tokens":2652,"cache_read_tokens":70379,"output_tokens":1504,"thinking":"Constructing the UCI adapter, the primary function is to format and parse commands for communication with the Stockfish engine. The adapter will format UCI commands like `uci`, `setoption`, `isready`, `ucinewgame`, `position`, `go`, and `stop`. It also must parse the engine's output, including `uciok`, `readyok`, `bestmove`, and `info` lines.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import { EngineEvaluation } from '../types/chess';\n\nexport interface ParsedUciLine {\n  type: 'uciok' | 'readyok' | 'bestmove' | 'info' | 'other';\n  raw: string;\n  bestMove?: string;\n  ponder?: string;\n  evalInfo?: EngineEvaluation;\n}\n\nexport class UciAdapter {\n  /**\n   * Parse a raw line emitted by Stockfish engine\n   */\n  public static parse(line: string): ParsedUciLine {\n    const trimmed = line.trim();\n\n    if (trimmed === 'uciok') {\n      return { type: 'uciok', raw: trimmed };\n    }\n\n    if (trimmed === 'readyok') {\n      return { type: 'readyok', raw: trimmed };\n    }\n\n    if (trimmed.startsWith('bestmove')) {\n      // Format: bestmove e7e5 [ponder g1f3] or bestmove (none)\n      const parts = trimmed.split(' ');\n      const bestMove = parts[1] !== '(none)' ? parts[1] : undefined;\n      const ponderIndex = parts.indexOf('ponder');\n      const ponder = ponderIndex !== -1 ? parts[ponderIndex + 1] : undefined;\n\n      return {\n        type: 'bestmove',\n        raw: trimmed,\n        bestMove,\n        ponder,\n      };\n    }\n\n    if (trimmed.startsWith('info') && (trimmed.includes('score') || trimmed.includes('depth'))) {\n      const evalInfo = this.parseInfoLine(trimmed);\n      return {\n        type: 'info',\n        raw: trimmed,\n        evalInfo,\n      };\n    }\n\n    return { type: 'other', raw: trimmed };\n  }\n\n  private static parseInfoLine(line: string): EngineEvaluation {\n    const tokens = line.split(' ');\n    const result: EngineEvaluation = {\n      depth: 0,\n    };\n\n    for (let i = 0; i < tokens.length; i++) {\n      const token = tokens[i];\n      if (token === 'depth' && tokens[i + 1]) {\n        result.depth = parseInt(tokens[i + 1], 10);\n      } else if (token === 'seldepth' && tokens[i + 1]) {\n        result.seldepth = parseInt(tokens[i + 1], 10);\n      } else if (token === 'score') {\n        const type = tokens[i + 1];\n        const val = parseInt(tokens[i + 2], 10);\n        if (type === 'cp') {\n          result.scoreCp = val;\n        } else if (type === 'mate') {\n          result.scoreMate = val;\n        }\n      } else if (token === 'nodes' && tokens[i + 1]) {\n        result.nodes = parseInt(tokens[i + 1], 10);\n      } else if (token === 'nps' && tokens[i + 1]) {\n        result.nps = parseInt(tokens[i + 1], 10);\n      } else if (token === 'time' && tokens[i + 1]) {\n        result.timeMs = parseInt(tokens[i + 1], 10);\n      } else if (token === 'pv') {\n        result.pv = tokens.slice(i + 1, i + 6).join(' ');\n      }\n    }\n\n    return result;\n  }\n\n  /**\n   * Convert a UCI move string (e.g. 'e2e4' or 'e7e8q') into chess.js move params\n   */\n  public static uciToChessMove(uciMove: string): {\n    from: string;\n    to: string;\n    promotion?: 'q' | 'r' | 'b' | 'n';\n  } {\n    const from = uciMove.slice(0, 2);\n    const to = uciMove.slice(2, 4);\n    const promoChar = uciMove.length > 4 ? uciMove[4].toLowerCase() : undefined;\n    const promotion = promoChar && ['q', 'r', 'b', 'n'].includes(promoChar)\n      ? (promoChar as 'q' | 'r' | 'b' | 'n')\n      : undefined;\n\n    return { from, to, promotion };\n  }\n\n  /**\n   * Convert centipawn score to friendly display string (e.g. \"+1.25\", \"-0.80\", \"#M3\")\n   */\n  public static formatScore(scoreCp?: number, scoreMate?: number, turn: 'w' | 'b' = 'w'): string {\n    if (scoreMate !== undefined) {\n      const mateIn = turn === 'w' ? scoreMate : -scoreMate;\n      return mateIn > 0 ? `#+${mateIn}` : `#-M${Math.abs(mateIn)}`;\n    }\n\n    if (scoreCp !== undefined) {\n      // Stockfish score is from engine's POV (active turn in position)\n      const adjusted = turn === 'w' ? scoreCp / 100 : -(scoreCp / 100);\n      const sign = adjusted > 0 ? '+' : '';\n      return `${sign}${adjusted.toFixed(2)}`;\n    }\n\n    return '0.00';\n  }\n}\n","Path":"C:\\Users\\DELL\\.gemini\\antigravity\\scratch\\stockfish-chess-arena\\src\\engine\\uciAdapter.ts"}}]}
