{"step_index":345,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-24T09:41:34Z","content":"Created At: 2026-11-24T14:41:34+05:00\nCompleted At: 2026-11-24T14:41:34+05:00\nCreated At: 2026-11-24T14:41:34+05:00\nCompleted At: 2026-11-24T14:41:34+05:00\nShowing lines 121-240 of 240\n121:       if (parsed.bestMove) {\n122:         if (this.currentEval) {\n123:           this.currentEval.bestMove = parsed.bestMove;\n124:           this.currentEval.ponder = parsed.ponder;\n125:         }\n126:       }\n127: \n128:       this.notifyStatus();\n129: \n130:       if (this.pendingMoveResolve) {\n131:         const resolve = this.pendingMoveResolve;\n132:         this.pendingMoveResolve = null;\n133:         this.pendingMoveReject = null;\n134:         resolve(parsed.bestMove || '');\n135:       }\n136:     }\n137:   }\n138: \n139:   /**\n140:    * Applies difficulty options (Skill Level: 0 to 20)\n141:    */\n142:   public setDifficulty(config: DifficultyConfig) {\n143:     if (!this.worker) return;\n144:     this.send(`setoption name Skill Level value ${Math.min(20, Math.max(0, config.skillLevel))}`);\n145:     this.send('isready');\n146:   }\n147: \n148:   /**\n149:    * Resets engine state for a fresh game\n150:    */\n151:   public newGame() {\n152:     this.stop();\n153:     this.send('ucinewgame');\n154:     this.send('isready');\n155:     this.currentEval = null;\n156:     this.notifyStatus();\n157:   }\n158: \n159:   /**\n160:    * Stops active search calculation\n161:    */\n162:   public stop() {\n163:     this.clearWatchdog();\n164:     if (this.isThinking) {\n165:       this.send('stop');\n166:       this.isThinking = false;\n167:       this.notifyStatus();\n168:     }\n169:   }\n170: \n171:   private clearWatchdog() {\n172:     if (this.watchdogTimer !== null) {\n173:       clearTimeout(this.watchdogTimer);\n174:       this.watchdogTimer = null;\n175:     }\n176:   }\n177: \n178:   /**\n179:    * Asks Stockfish to calculate the best move for given FEN position.\n180:    * Returns a promise that resolves with the UCI move (e.g. 'e7e5').\n181:    */\n182:   public calculateBestMove(fen: string, config: DifficultyConfig): Promise<string> {\n183:     return new Promise((resolve, reject) => {\n184:       if (!this.worker) {\n185:         this.initWorker();\n186:       }\n187: \n188:       // If already thinking, abort previous calculation\n189:       if (this.isThinking) {\n190:         this.stop();\n191:       }\n192: \n193:       this.isThinking = true;\n194:       this.currentEval = null;\n195:       this.pendingMoveResolve = resolve;\n196:       this.pendingMoveReject = reject;\n197:       this.notifyStatus();\n198: \n199:       // Configure skill level\n200:       this.setDifficulty(config);\n201: \n202:       // Setup position\n203:       this.send(`position fen ${fen}`);\n204: \n205:       // Issue go command with depth and/or movetime\n206:       const depth = Math.max(1, config.depth);\n207:       const moveTime = config.moveTime ? Math.max(100, config.moveTime) : undefined;\n208:       const goCmd = moveTime ? `go depth ${depth} movetime ${moveTime}` : `go depth ${depth}`;\n209:       this.send(goCmd);\n210: \n211:       // Safety watchdog: if engine takes > (moveTime + 5000ms), force stop\n212:       const timeoutLimit = (moveTime || depth * 600) + 7000;\n213:       this.watchdogTimer = window.setTimeout(() => {\n214:         console.warn('Stockfish search exceeded timeout limit. Issuing stop.');\n215:         this.send('stop');\n216:       }, timeoutLimit);\n217:     });\n218:   }\n219: \n220:   /**\n221:    * Terminate worker process\n222:    */\n223:   public terminate() {\n224:     this.clearWatchdog();\n225:     if (this.worker) {\n226:       try {\n227:         this.worker.postMessage('quit');\n228:         this.worker.terminate();\n229:       } catch (e) {\n230:         console.error('Error terminating worker:', e);\n231:       }\n232:       this.worker = null;\n233:     }\n234:     this.